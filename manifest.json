{
  "manifest_version": 3,
  "name": "LinkedIn Puzzles Solver",
  "version": "1.0",
  "description": "Solve LinkedIn puzzles with one click",
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/games/*"],
      "js": ["scripts/content.js", "scripts/sudoku.js"],
      "css": ["styles/content.css"]
    }
  ]
}
