{
  "manifest_version": 3,
  "name": "LinkedIn Puzzles Solver",
  "version": "1.0",
  "description": "Solve LinkedIn puzzles with one click",
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/games/*"],
      "js": [
        "scripts/content.js",
        "scripts/solvers/sudoku.js",
        "scripts/solvers/tango.js",
        "scripts/solvers/crossclimb.js"
      ],
      "css": ["styles/content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/answers.json"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}
